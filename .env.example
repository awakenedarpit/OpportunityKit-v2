NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Primary Gemini model. Set this to a model enabled for your API key.
GEMINI_MODEL=gemini-2.5-flash
# Used after repeated transient errors or if the primary model is unavailable.
# Choose a different model that is enabled for your API key if needed.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Independent provider fallback, used if Gemini models are unavailable.
# Add a real OpenRouter API key in Vercel; never commit the key here.
OPENROUTER_API_KEY=
# Choose a model currently available to your OpenRouter account.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Last-resort provider fallback if Gemini and OpenRouter fail.
# Create a Groq API key and add it in Vercel; never commit the key here.
GROQ_API_KEY=
# Use a model enabled for your Groq account.
GROQ_MODEL=llama-3.3-70b-versatile
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v2
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
APP_BASE_URL=http://localhost:3000
CRON_SECRET=
